# Application
APP_NAME=production-rag
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
# Master switch for application logs (false = no log output)
LOG_ENABLED=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:rag_secret@postgres:5432/rag
DATABASE_URL_SYNC=postgresql+psycopg2://rag:rag_secret@postgres:5432/rag

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_API_KEY=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# Ollama (LLM – local only)
# From Dockerized API talking to Ollama on the host:
#   Linux / Docker Desktop: http://host.docker.internal:11434
# From API running on the host itself:
#   http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Embeddings (independent of LLM; Phase 7+)
# LLM remains Ollama-only. These settings are for embeddings only.
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VERSION=1
EMBEDDING_MAX_RETRIES=3
EMBEDDING_CACHE_TTL_SECONDS=604800
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
OPENAI_TIMEOUT=60

# Ingestion / chunking defaults (Phase 3–6)
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_STRATEGY=recursive
CHUNK_PARENT_SIZE=2000
CHUNK_SEMANTIC_THRESHOLD=0.25

# Parsing (Phase 4+)
# auto | native | docling
PARSER_BACKEND=auto
PARSER_ENABLE_OCR=true
PARSER_OCR_MIN_CHARS=40
PARSER_STORE_FULL_TEXT=true

# Cleaning / metadata enrichment (Phase 5+)
CLEANER_ENABLED=true
CLEANER_FIX_HYPHENATION=true
CLEANER_STRIP_URLS=false
METADATA_ENRICHMENT_ENABLED=true
METADATA_MAX_KEYWORDS=15
METADATA_MAX_HEADINGS=20

# Qdrant indexing (Phase 8+)
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_HNSW_EF=128
QDRANT_EXACT_SEARCH=false
QDRANT_SCORE_THRESHOLD=0.0

# Retrieval defaults (Phase 10–12)
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5
RETRIEVAL_MODE=hybrid
RRF_K=60
BM25_CORPUS_LIMIT=5000
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Context / generation (Phase 13–15)
CONTEXT_MAX_TOKENS=3500

# Celery worker
CELERY_CONCURRENCY=2

# Observability (Phase 17)
METRICS_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
